NEXT_PUBLIC_USE_MOCK=false
# Used only when NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=/api/v1

# PostgreSQL (server only). DATABASE_URL, when set, overrides DB_*.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=book_shop
# DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:5432/book_shop

# Server only. Generate once with: npm run server:configure
AUTH_SECRET=
RETURN_WINDOW_DAYS=14
# Optional provider with a Chat Completions compatible endpoint. Otherwise rules mode.
AI_API_URL=
AI_API_KEY=
# Set only behind a trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=false
